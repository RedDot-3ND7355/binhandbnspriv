<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Migrated from .NET Framework 4.8 (ToolsVersion 12.0) to SDK-style net9.0-windows. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LegacyBin</RootNamespace>
    <AssemblyName>LegacyBin</AssemblyName>
    <StartupObject>LegacyBin.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Allows building the Windows-targeted app from Linux (test/smoke builds only). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- MaterialSkin WinForms theme (net45-era, works fine on modern .NET). -->
    <Reference Include="MaterialSkin">
      <HintPath>Resources\MaterialSkin.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded payloads loaded at runtime via EmbeddedAssembly. -->
    <EmbeddedResource Include="Resources\MaterialSkin.dll" />
  </ItemGroup>
</Project>
